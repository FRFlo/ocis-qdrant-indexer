		"bun",
		"cloudflare-workers-ai",
		"mcp",
		"nats",
		"ocis",
		"owncloud",
		"qdrant",
		"rag"
	],
	"homepage": "https://github.com/FRFlo/ocis-qdrant-indexer#readme",
