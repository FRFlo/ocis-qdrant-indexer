	"license": "MIT",
	"author": "FRFlo <admin@frflo.ovh>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FRFlo/ocis-qdrant-indexer.git"
	},
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"start": "bun run src/index.ts",
		"dev": "bun run --watch src/index.ts",
		"test": "bun test",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
